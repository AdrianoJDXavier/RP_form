{
    "manifest_version": 2,
    "name": "AutoFillForm",
    "version": "1.0",
    "description": "AutoFillForm preenche formulários automaticamente, útil para desenvolvedores e testadores de formulários web.",

    "permissions": [
        "tabs",
        "activeTab",
        "<all_urls>"
    ],

    "browser_action": {
        "default_icon": "button/logo.png",
        "default_title": "AutoFillForm",
        "default_popup": "popup/form.html"
    },

    "web_accessible_resources": [
        "button/logo.png"
    ],

    "content_scripts": [
        {
            "js": ["content_scripts/form_script.js", "content_scripts/form_script1.js"],
            "matches": ["https://*/*", "http://*/*"],
            "run_at": "document_idle"
        }
    ]
}